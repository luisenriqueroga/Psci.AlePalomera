generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id        String   @id @default(cuid())
  date      String
  timeSlot  String
  name      String
  email     String
  phone     String
  service   String
  notes     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model BlockedSlot {
  id       String @id @default(cuid())
  date     String
  timeSlot String

  @@unique([date, timeSlot])
}
